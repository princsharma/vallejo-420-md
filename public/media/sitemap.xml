<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:sitemap="http://www.sitemaps.org/schemas/sitemap/0.9">
  <xsl:output method="html" version="1.0" encoding="UTF-8" indent="yes" />
  <xsl:template match="/">
    <html lang="en">
      <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>XML Sitemap | Vallejo 420 MD</title>
        <style>
          :root {
            color-scheme: light;
            --ink: #10251f;
            --green: #0c251e;
            --green-soft: #eff5f1;
            --amber: #d3a15e;
            --paper: #fffaf4;
            --line: #e8e4de;
            --muted: #64716c;
          }
          * { box-sizing: border-box; }
          body {
            margin: 0;
            padding: 2rem 1rem;
            background: var(--paper);
            color: var(--ink);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
          }
          main {
            width: min(100%, 1080px);
            margin: 0 auto;
            overflow: hidden;
            border: 1px solid var(--line);
            border-radius: 12px;
            background: #fff;
            box-shadow: 0 8px 28px rgba(16, 37, 31, 0.06);
          }
          header {
            padding: 2rem 1.75rem;
            border-left: 3px solid var(--amber);
            background: var(--green);
            color: #fff;
          }
          h1 {
            margin: 0;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(1.8rem, 5vw, 2.5rem);
            line-height: 1.1;
          }
          header p {
            max-width: 720px;
            margin: 0.7rem 0 0;
            color: rgba(255, 255, 255, 0.82);
            font-size: 0.9rem;
            line-height: 1.6;
          }
          header a { color: #f0c17f; }
          .summary {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
            padding: 1rem 1.5rem;
            border-bottom: 1px solid var(--line);
          }
          .badge {
            display: inline-flex;
            align-items: center;
            min-height: 2rem;
            padding: 0.35rem 0.75rem;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: #fff;
            color: var(--ink);
            font-size: 0.75rem;
            font-weight: 600;
            box-shadow: 0 1px 2px rgba(16, 37, 31, 0.08);
          }
          .table-wrap { overflow-x: auto; }
          table {
            width: 100%;
            min-width: 680px;
            border-collapse: collapse;
            font-size: 0.85rem;
          }
          th, td {
            padding: 0.8rem 1.5rem;
            border-bottom: 1px solid var(--line);
            text-align: left;
          }
          thead th {
            color: var(--muted);
            background: #fffdf9;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.07em;
            text-transform: uppercase;
          }
          .section-row th {
            padding-top: 0.65rem;
            padding-bottom: 0.65rem;
            background: var(--green-soft);
            color: var(--ink);
            font-size: 0.68rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
          }
          .phase {
            margin-right: 0.45rem;
            padding: 0.2rem 0.4rem;
            border-radius: 3px;
            background: #dcebe1;
            color: #315746;
            font-size: 0.58rem;
          }
          .count { color: var(--muted); font-weight: 500; }
          tbody tr.url-row:hover td { background: #fbfaf7; }
          .url { overflow-wrap: anywhere; }
          a { color: #164b3a; text-underline-offset: 2px; }
          a:hover { color: #0c251e; text-decoration-thickness: 2px; }
          .frequency {
            display: inline-block;
            padding: 0.25rem 0.55rem;
            border-radius: 999px;
            background: var(--green-soft);
            color: #315746;
            font-size: 0.72rem;
          }
          @media (max-width: 600px) {
            body { padding: 1rem 0.5rem; }
            header { padding: 1.5rem 1.25rem; }
            .summary { padding: 0.85rem 1.25rem; }
            th, td { padding-right: 1rem; padding-left: 1rem; }
          }
        </style>
      </head>
      <body>
        <main>
          <header>
            <h1>XML Sitemap</h1>
            <p>
              This sitemap lists the public pages on Vallejo 420 MD for search engines and site audits.
              Crawlers should use the machine-readable feed at
              <a href="/sitemap.xml">/sitemap.xml</a>.
            </p>
          </header>
          <div class="summary">
            <span class="badge">
              <xsl:value-of select="count(sitemap:urlset/sitemap:url)" /> URLs indexed
            </span>
            <span class="badge">Sitemap protocol 0.9</span>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>URL</th>
                  <th>Last Modified</th>
                  <th>Change Frequency</th>
                  <th>Priority</th>
                </tr>
              </thead>
              <tbody>
                <tr class="section-row">
                  <th colspan="4">
                    <span class="phase">PHASE 0</span>
                    HOME
                    <span class="count">
                      (<xsl:value-of select="count(sitemap:urlset/sitemap:url[sitemap:loc = 'https://vallejo420md.com/'])" />)
                    </span>
                  </th>
                </tr>
                <xsl:for-each select="sitemap:urlset/sitemap:url[sitemap:loc = 'https://vallejo420md.com/']">
                  <xsl:call-template name="url-row" />
                </xsl:for-each>

                <tr class="section-row">
                  <th colspan="4">
                    <span class="phase">PHASE 1</span>
                    CORE PAGES
                    <span class="count">
                      (<xsl:value-of select="count(sitemap:urlset/sitemap:url[not(sitemap:loc = 'https://vallejo420md.com/') and not(contains(sitemap:loc, '/policy/')) and not(contains(sitemap:loc, '/our-doctors/'))])" />)
                    </span>
                  </th>
                </tr>
                <xsl:for-each select="sitemap:urlset/sitemap:url[not(sitemap:loc = 'https://vallejo420md.com/') and not(contains(sitemap:loc, '/policy/')) and not(contains(sitemap:loc, '/our-doctors/'))]">
                  <xsl:sort select="sitemap:loc" />
                  <xsl:call-template name="url-row" />
                </xsl:for-each>

                <tr class="section-row">
                  <th colspan="4">
                    <span class="phase">PHASE 2</span>
                    DOCTOR PAGES
                    <span class="count">
                      (<xsl:value-of select="count(sitemap:urlset/sitemap:url[contains(sitemap:loc, '/our-doctors/')])" />)
                    </span>
                  </th>
                </tr>
                <xsl:for-each select="sitemap:urlset/sitemap:url[contains(sitemap:loc, '/our-doctors/')]">
                  <xsl:sort select="sitemap:loc" />
                  <xsl:call-template name="url-row" />
                </xsl:for-each>

                <tr class="section-row">
                  <th colspan="4">
                    <span class="phase">PHASE 3</span>
                    LEGAL &amp; POLICY
                    <span class="count">
                      (<xsl:value-of select="count(sitemap:urlset/sitemap:url[contains(sitemap:loc, '/policy/')])" />)
                    </span>
                  </th>
                </tr>
                <xsl:for-each select="sitemap:urlset/sitemap:url[contains(sitemap:loc, '/policy/')]">
                  <xsl:sort select="sitemap:loc" />
                  <xsl:call-template name="url-row" />
                </xsl:for-each>
              </tbody>
            </table>
          </div>
        </main>
      </body>
    </html>
  </xsl:template>

  <xsl:template name="url-row">
    <tr class="url-row">
      <td class="url">
        <a href="{sitemap:loc}">
          <xsl:value-of select="sitemap:loc" />
        </a>
      </td>
      <td><xsl:value-of select="sitemap:lastmod" /></td>
      <td><span class="frequency"><xsl:value-of select="sitemap:changefreq" /></span></td>
      <td><xsl:value-of select="sitemap:priority" /></td>
    </tr>
  </xsl:template>
</xsl:stylesheet>
